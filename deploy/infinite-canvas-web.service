[Unit]
Description=无限画布前端 infinite-canvas web（Vite dev server, :3000）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/sobey/canvas-plus/web
ExecStart=/root/.bun/bin/bun run dev
Restart=always
RestartSec=3
StandardOutput=append:/var/log/infinite-canvas-web.log
StandardError=append:/var/log/infinite-canvas-web.log

[Install]
WantedBy=multi-user.target
